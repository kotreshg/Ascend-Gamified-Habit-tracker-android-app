<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Radiant Halo -->
    <path
        android:pathData="M54,34 m-14,0 a14,14 0 1,0 28,0 a14,14 0 1,0 -28,0"
        android:strokeWidth="2.5"
        android:strokeColor="#FFDFB15B"
        android:fillColor="#00000000" />
    
    <!-- Central Ascension Peak (Outer Mountain) -->
    <path
        android:pathData="M54,26 L76,68 L64,68 L54,48 L44,68 L32,68 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="32"
                android:startY="26"
                android:endX="76"
                android:endY="68"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFF6D365" />
                <item android:offset="0.5" android:color="#FFE5A93B" />
                <item android:offset="1.0" android:color="#FFB37D14" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Ascension Diamond/Spire -->
    <path
        android:pathData="M54,38 L62,56 L54,74 L46,56 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="46"
                android:startY="38"
                android:endX="62"
                android:endY="74"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFFFFF" />
                <item android:offset="0.6" android:color="#FFFCE0A6" />
                <item android:offset="1.0" android:color="#FFD4AF37" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Horizon Foundation Line -->
    <path
        android:pathData="M30,73 L78,73"
        android:strokeWidth="2"
        android:strokeColor="#FFE5A93B"
        android:strokeLineCap="round" />

    <path
        android:pathData="M38,77 L70,77"
        android:strokeWidth="1.5"
        android:strokeColor="#99DFB15B"
        android:strokeLineCap="round" />
</vector>
